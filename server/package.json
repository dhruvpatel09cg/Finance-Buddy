  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "postinstall": "prisma generate",
    "build": "prisma generate && tsc",
    "start": "prisma migrate deploy && node dist/server.js",
    "seed": "tsx prisma/seed.ts",
